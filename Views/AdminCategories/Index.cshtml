@model List<AdminCategoryItemViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kelola Kategori";
}

<div class="mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Manajemen Kategori</h1>
            <p class="text-muted small mb-0">Kelola kategori dan topik untuk pengelompokan artikel berita.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i>
                <span>Tambah Kategori</span>
            </a>
        </div>
    </div>
</div>

<div class="card border shadow-subtle overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-secondary text-uppercase">
                <tr>
                    <th>Nama Kategori</th>
                    <th>Slug URL</th>
                    <th>Deskripsi</th>
                    <th class="text-center">Jumlah Artikel</th>
                    <th class="text-end" style="min-width: 120px;">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            Belum ada kategori yang dibuat.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var c in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-bold text-dark">@c.Name</span>
                            </td>
                            <td>
                                <code>@c.Slug</code>
                            </td>
                            <td class="small text-muted" style="max-width: 250px;">
                                @(string.IsNullOrEmpty(c.Description) ? "-" : c.Description)
                            </td>
                            <td class="text-center">
                                @if (c.ArticleCount > 0)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                                        @c.ArticleCount Artikel
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border rounded-pill px-3 py-1">
                                        0 Artikel
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-secondary" title="Edit Kategori">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @if (c.ArticleCount > 0)
                                    {
                                        <button type="button" class="btn btn-outline-secondary disabled" title="Tidak dapat dihapus karena masih memiliki artikel" disabled>
                                            <i class="bi bi-lock"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteCat-@c.Id" title="Hapus Kategori">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>

                                @if (c.ArticleCount == 0)
                                {
                                    <div class="modal fade" id="deleteCat-@c.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered text-start">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title fs-6 fw-bold">Hapus Kategori</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="mb-2">Yakin ingin menghapus kategori ini?</p>
                                                    <div class="p-2 bg-light rounded small fw-bold text-dark">
                                                        @c.Name
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                                                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm">Ya, Hapus</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
