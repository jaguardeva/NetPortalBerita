@model AdminArticleListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kelola Semua Artikel";
}

<div class="mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Manajemen Seluruh Artikel</h1>
            <p class="text-muted small mb-0">Kelola dan pantau seluruh konten publikasi dari seluruh penulis platform.</p>
        </div>
        <div>
            <a asp-controller="Author" asp-action="Create" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i>
                <span>Tulis Artikel Baru</span>
            </a>
        </div>
    </div>
</div>

<!-- Filters Bar -->
<div class="card border shadow-subtle mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Cari judul atau nama penulis..." value="@Model.SearchQuery" />
                </div>
            </div>
            <div class="col-6 col-md-3">
                <select name="categoryId" class="form-select" onchange="this.form.submit()">
                    <option value="">Semua Kategori</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Value" selected="@cat.Selected">@cat.Text</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">Semua Status</option>
                    <option value="Published" selected="@(Model.StatusFilter == ArticleStatus.Published)">Dipublikasikan</option>
                    <option value="Draft" selected="@(Model.StatusFilter == ArticleStatus.Draft)">Draf</option>
                    <option value="Archived" selected="@(Model.StatusFilter == ArticleStatus.Archived)">Diarsipkan</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100">
                    Filter
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery) || Model.CategoryFilter.HasValue || Model.StatusFilter.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset filter">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Articles Table -->
<div class="card border shadow-subtle overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-secondary text-uppercase">
                <tr>
                    <th scope="col" style="min-width: 260px;">Artikel</th>
                    <th scope="col">Penulis</th>
                    <th scope="col">Kategori</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-center">Aktivitas</th>
                    <th scope="col" class="text-end" style="min-width: 140px;">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Articles.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-journal-x fs-2 d-block mb-2 opacity-50"></i>
                            Tidak ditemukan artikel yang sesuai filter.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var a in Model.Articles)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark text-truncate" style="max-width: 280px;" title="@a.Title">
                                    @a.Title
                                </div>
                                <div class="small text-muted text-truncate" style="max-width: 280px;">
                                    Slug: <code>@a.Slug</code>
                                </div>
                                <small class="text-muted" style="font-size: 0.72rem;">Dibuat: @a.CreatedAt.ToString("dd MMM yyyy, HH:mm")</small>
                            </td>
                            <td>
                                <span class="fw-medium small">@a.AuthorName</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@a.CategoryName</span>
                            </td>
                            <td>
                                @if (a.Status == ArticleStatus.Published)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                        <i class="bi bi-check-circle me-1"></i>Terbit
                                    </span>
                                }
                                else if (a.Status == ArticleStatus.Draft)
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2 py-1">
                                        <i class="bi bi-clock me-1"></i>Draf
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill px-2 py-1">Diarsipkan</span>
                                }
                            </td>
                            <td class="text-center small text-muted">
                                <span class="me-2"><i class="bi bi-heart text-danger"></i> @a.LikesCount</span>
                                <span><i class="bi bi-chat text-primary"></i> @a.CommentsCount</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <!-- View Link -->
                                    <a asp-controller="Articles" asp-action="Detail" asp-route-slug="@a.Slug" target="_blank" class="btn btn-outline-secondary" title="Lihat di Web">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>

                                    <!-- Edit Link -->
                                    <a asp-controller="Author" asp-action="Edit" asp-route-id="@a.Id" class="btn btn-outline-secondary" title="Edit Artikel">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <!-- Toggle Publish/Draft -->
                                    <form asp-action="ToggleStatus" asp-route-id="@a.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-secondary" title="@(a.Status == ArticleStatus.Published ? "Jadikan Draf" : "Publikasikan")">
                                            <i class="bi @(a.Status == ArticleStatus.Published ? "bi-eye-slash" : "bi-upload text-success")"></i>
                                        </button>
                                    </form>

                                    <!-- Delete Button -->
                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteAdminArticle-@a.Id" title="Hapus Artikel">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>

                                <!-- Delete Modal -->
                                <div class="modal fade" id="deleteAdminArticle-@a.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered text-start">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fs-6 fw-bold">Hapus Artikel (Admin)</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-2">Sebagai Admin, Anda akan menghapus artikel ini secara permanen beserta file gambarnya:</p>
                                                <div class="p-2 bg-light rounded small fw-bold text-dark mb-2">
                                                    @a.Title
                                                </div>
                                                <small class="text-danger d-block">Tindakan ini tidak dapat dibatalkan.</small>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                                                <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger btn-sm">Hapus Permanen</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-top py-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <small class="text-muted">
                Halaman @Model.CurrentPage dari @Model.TotalPages (Total @Model.TotalCount artikel)
            </small>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-categoryId="@Model.CategoryFilter" asp-route-status="@Model.StatusFilter" asp-route-search="@Model.SearchQuery">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-categoryId="@Model.CategoryFilter" asp-route-status="@Model.StatusFilter" asp-route-search="@Model.SearchQuery">
                            @i
                        </a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-categoryId="@Model.CategoryFilter" asp-route-status="@Model.StatusFilter" asp-route-search="@Model.SearchQuery">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>
