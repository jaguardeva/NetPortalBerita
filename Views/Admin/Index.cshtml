@model AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard Utama";
}

<div class="mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Dashboard Ikhtisar</h1>
            <p class="text-muted small mb-0">Selamat datang di pusat kendali dan administrasi portal berita.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Author" asp-action="Create" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i>
                <span>Tulis Artikel</span>
            </a>
            <a asp-controller="AdminCategories" asp-action="Create" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1">
                <i class="bi bi-folder-plus"></i>
                <span>Tambah Kategori</span>
            </a>
        </div>
    </div>
</div>

<!-- Key Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-stat-card">
            <div>
                <div class="stat-title">Total Artikel</div>
                <div class="stat-number text-primary">@Model.TotalArticles</div>
                <div class="small text-muted mt-1">
                    <span class="text-success fw-semibold">@Model.PublishedArticles</span> Terbit &middot;
                    <span class="text-warning fw-semibold">@Model.DraftArticles</span> Draf
                </div>
            </div>
            <div class="stat-icon bg-primary-subtle text-primary">
                <i class="bi bi-file-earmark-text"></i>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-stat-card">
            <div>
                <div class="stat-title">Kategori Berita</div>
                <div class="stat-number text-info">@Model.TotalCategories</div>
                <div class="small text-muted mt-1">
                    Topik publikasi aktif
                </div>
            </div>
            <div class="stat-icon bg-info-subtle text-info">
                <i class="bi bi-tags"></i>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-stat-card">
            <div>
                <div class="stat-title">Total Pengguna</div>
                <div class="stat-number text-success">@Model.TotalUsers</div>
                <div class="small text-muted mt-1">
                    <span class="fw-semibold text-primary">@Model.AuthorsCount</span> Penulis &middot;
                    <span class="fw-semibold text-success">@Model.ActiveUsers</span> Aktif
                </div>
            </div>
            <div class="stat-icon bg-success-subtle text-success">
                <i class="bi bi-people"></i>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-stat-card">
            <div>
                <div class="stat-title">Komentar & Suka</div>
                <div class="stat-number text-danger">@Model.TotalComments</div>
                <div class="small text-muted mt-1">
                    <span>@Model.TotalLikes Total Suka</span>
                </div>
            </div>
            <div class="stat-icon bg-danger-subtle text-danger">
                <i class="bi bi-chat-heart"></i>
            </div>
        </div>
    </div>
</div>

<!-- Tables: Recent Articles & Recent Comments -->
<div class="row g-4">
    <!-- Recent Articles -->
    <div class="col-12 col-lg-7">
        <div class="card border shadow-subtle h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title fs-6 mb-0 fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-primary"></i> Artikel Terbaru
                </h5>
                <a asp-controller="AdminArticles" asp-action="Index" class="small text-primary text-decoration-none fw-semibold">
                    Kelola Semua <i class="bi bi-chevron-right"></i>
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-secondary">
                        <tr>
                            <th>Judul</th>
                            <th>Kategori</th>
                            <th>Penulis</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentArticles.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted small">Belum ada artikel.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var a in Model.RecentArticles)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold text-truncate" style="max-width: 220px;" title="@a.Title">
                                            @a.Title
                                        </div>
                                        <small class="text-muted" style="font-size: 0.72rem;">@a.CreatedAt.ToString("dd MMM yyyy, HH:mm")</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@a.CategoryName</span>
                                    </td>
                                    <td class="small">@a.AuthorName</td>
                                    <td>
                                        @if (a.Status == ArticleStatus.Published)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1" style="font-size: 0.7rem;">Terbit</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2 py-1" style="font-size: 0.7rem;">Draf</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Comments -->
    <div class="col-12 col-lg-5">
        <div class="card border shadow-subtle h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title fs-6 mb-0 fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-chat-quote text-info"></i> Komentar Terbaru
                </h5>
                <a asp-controller="AdminComments" asp-action="Index" class="small text-primary text-decoration-none fw-semibold">
                    Moderasi <i class="bi bi-chevron-right"></i>
                </a>
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentComments.Any())
                {
                    <div class="text-center py-5 text-muted small">Belum ada komentar terbaru.</div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var c in Model.RecentComments)
                        {
                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold small text-dark">@c.UserName</span>
                                    <small class="text-muted" style="font-size: 0.72rem;">@c.CreatedAt.ToString("dd/MM/yy HH:mm")</small>
                                </div>
                                <p class="small text-muted mb-1 line-clamp-2">@c.Content</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-truncate text-secondary" style="max-width: 200px;" title="@c.ArticleTitle">
                                        <i class="bi bi-link-45deg"></i> @c.ArticleTitle
                                    </small>
                                    @if (c.Status == CommentStatus.Published)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" style="font-size: 0.68rem;">Terbit</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill" style="font-size: 0.68rem;">Disembunyikan</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
