@model HomeViewModel
@{
    ViewData["Title"] = "Portal Berita Terkini & Terpercaya";
}

<!-- Breaking News Bar (DESIGN.md §13) -->
@if (Model.BreakingNews != null)
{
    <div class="breaking-news-bar d-flex align-items-center gap-3 mb-4 shadow-subtle">
        <div class="breaking-news-badge flex-shrink-0">
            <i class="bi bi-lightning-fill me-1"></i> Terkini
        </div>
        <div class="overflow-hidden text-truncate">
            <a asp-controller="Articles" asp-action="Detail" asp-route-slug="@Model.BreakingNews.Slug" class="text-dark fw-semibold text-decoration-none text-hover-primary text-truncate d-block small">
                @Model.BreakingNews.Title
            </a>
        </div>
    </div>
}

<!-- Hero Section (DESIGN.md §14) -->
@if (Model.HeroArticle != null)
{
    <section class="mb-5">
        <div class="row g-4">
            <!-- Main Hero Article (8 cols) -->
            <div class="col-12 col-lg-8">
                <div class="card border-0 rounded-3 overflow-hidden shadow-subtle h-100 position-relative article-card">
                    <div class="position-relative" style="aspect-ratio: 16/9; background-color: var(--color-surface-dark);">
                        @if (!string.IsNullOrEmpty(Model.HeroArticle.FeaturedImageUrl))
                        {
                            <a asp-controller="Articles" asp-action="Detail" asp-route-slug="@Model.HeroArticle.Slug" class="d-block w-100 h-100">
                                <img src="@Model.HeroArticle.FeaturedImageUrl" alt="@Model.HeroArticle.Title" class="w-100 h-100 object-fit-cover article-thumb" />
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Articles" asp-action="Detail" asp-route-slug="@Model.HeroArticle.Slug" class="d-flex w-100 h-100 align-items-center justify-content-center text-decoration-none text-muted">
                                <i class="bi bi-newspaper fs-1 opacity-50"></i>
                            </a>
                        }
                        <a asp-controller="Categories" asp-action="Detail" asp-route-slug="@Model.HeroArticle.CategorySlug" class="position-absolute top-0 start-0 m-3 badge bg-primary text-white text-decoration-none rounded-pill px-3 py-1 fw-semibold shadow-sm">
                            @Model.HeroArticle.CategoryName
                        </a>
                    </div>
                    <div class="card-body p-4 d-flex flex-column">
                        <h2 class="card-title fw-bold mb-2 fs-3">
                            <a asp-controller="Articles" asp-action="Detail" asp-route-slug="@Model.HeroArticle.Slug" class="text-dark text-decoration-none text-hover-primary">
                                @Model.HeroArticle.Title
                            </a>
                        </h2>
                        <p class="card-text text-secondary mb-3 line-clamp-2">
                            @Model.HeroArticle.Excerpt
                        </p>
                        <div class="d-flex align-items-center justify-content-between pt-3 border-top text-muted small mt-auto">
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-circle-sm" style="width: 28px; height: 28px;">
                                    @(string.IsNullOrEmpty(Model.HeroArticle.AuthorName) ? "R" : Model.HeroArticle.AuthorName.Substring(0, 1).ToUpper())
                                </span>
                                <span class="fw-medium">@Model.HeroArticle.AuthorName</span>
                                <span>&bull;</span>
                                <span>@Model.HeroArticle.PublishedAt.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID"))</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span><i class="bi bi-clock me-1"></i>@Model.HeroArticle.ReadingTimeMinutes mnt</span>
                                <span><i class="bi bi-heart text-danger ms-2 me-1"></i>@Model.HeroArticle.LikesCount</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Secondary Hero Articles (4 cols) -->
            <div class="col-12 col-lg-4">
                <div class="card border shadow-subtle h-100">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="fw-bold fs-6 mb-0 text-uppercase text-secondary d-flex align-items-center gap-2">
                            <i class="bi bi-fire text-danger"></i> Sorotan Utama
                        </h5>
                    </div>
                    <div class="card-body p-3">
                        @if (Model.SecondaryHeroArticles.Any())
                        {
                            foreach (var article in Model.SecondaryHeroArticles)
                            {
                                <partial name="_ArticleListItem" model="article" />
                            }
                        }
                        else
                        {
                            <p class="text-muted small my-4 text-center">Belum ada artikel sorotan lainnya.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
}
else
{
    <div class="card border shadow-subtle text-center py-5 my-5">
        <div class="card-body">
            <i class="bi bi-newspaper fs-1 text-muted opacity-50 mb-3 d-block"></i>
            <h3 class="fw-bold">Selamat Datang di NewsPortal</h3>
            <p class="text-muted small mb-4">Belum ada artikel yang dipublikasikan. Masuk sebagai Penulis atau Admin untuk mulai menerbitkan berita.</p>
            <a asp-controller="Author" asp-action="Create" class="btn btn-primary btn-sm px-4">
                <i class="bi bi-pen me-1"></i> Buat Artikel Pertama
            </a>
        </div>
    </div>
}

<!-- Category Navigation Bar -->
@if (Model.Categories.Any())
{
    <section class="mb-5">
        <div class="p-3 bg-light rounded-3 border d-flex flex-wrap align-items-center gap-2">
            <span class="fw-bold small text-secondary me-2">Kategori:</span>
            @foreach (var cat in Model.Categories)
            {
                <a asp-controller="Categories" asp-action="Detail" asp-route-slug="@cat.Slug" class="btn btn-sm btn-outline-secondary bg-white text-dark rounded-pill px-3 py-1" style="font-size: 0.85rem;">
                    @cat.Name
                    @if (cat.ArticleCount > 0)
                    {
                        <span class="badge bg-secondary ms-1 rounded-pill" style="font-size: 0.7rem;">@cat.ArticleCount</span>
                    }
                </a>
            }
        </div>
    </section>
}

<!-- Latest News Section (DESIGN.md §15) -->
@if (Model.LatestArticles.Any())
{
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <h3 class="h4 mb-0 fw-bold border-start border-4 border-primary ps-3">Berita Terbaru</h3>
            <a asp-controller="Articles" asp-action="Index" class="btn btn-sm btn-outline-primary">
                Lihat Semua <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var article in Model.LatestArticles)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <partial name="_ArticleCard" model="article" />
                </div>
            }
        </div>
    </section>
}

<!-- Popular Articles Section -->
@if (Model.PopularArticles.Any())
{
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <h3 class="h4 mb-0 fw-bold border-start border-4 border-accent ps-3">Paling Banyak Disukai</h3>
        </div>

        <div class="row g-4">
            @foreach (var article in Model.PopularArticles.Take(3))
            {
                <div class="col-12 col-md-4">
                    <partial name="_ArticleCard" model="article" />
                </div>
            }
        </div>
    </section>
}

<!-- Category Sections (DESIGN.md §17) -->
@if (Model.CategorySections.Any())
{
    foreach (var catSection in Model.CategorySections)
    {
        <section class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <h3 class="h4 mb-0 fw-bold border-start border-4 border-primary ps-3">@catSection.CategoryName</h3>
                <a asp-controller="Categories" asp-action="Detail" asp-route-slug="@catSection.CategorySlug" class="btn btn-sm btn-outline-secondary">
                    Selengkapnya <i class="bi bi-chevron-right ms-1"></i>
                </a>
            </div>

            <div class="row g-4">
                @foreach (var article in catSection.Articles)
                {
                    <div class="col-12 col-md-6 col-lg-3">
                        <partial name="_ArticleCard" model="article" />
                    </div>
                }
            </div>
        </section>
    }
}
