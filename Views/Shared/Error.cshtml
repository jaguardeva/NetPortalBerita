@model ErrorViewModel
@{
    var statusCode = Model.StatusCode ?? 500;
    ViewData["Title"] = statusCode == 404 ? "Halaman Tidak Ditemukan" : "Terjadi Kesalahan";
}

<div class="container py-5">
    <div class="row justify-content-center py-5">
        <div class="col-12 col-md-8 col-lg-6 text-center">
            <div class="mb-4">
                @if (statusCode == 404)
                {
                    <span class="avatar-circle mx-auto bg-primary-subtle text-primary border-primary-subtle" style="width: 80px; height: 80px; font-size: 2.25rem;">
                        <i class="bi bi-compass"></i>
                    </span>
                }
                else if (statusCode == 403)
                {
                    <span class="avatar-circle mx-auto bg-warning-subtle text-warning border-warning-subtle" style="width: 80px; height: 80px; font-size: 2.25rem;">
                        <i class="bi bi-shield-x"></i>
                    </span>
                }
                else
                {
                    <span class="avatar-circle mx-auto bg-danger-subtle text-danger border-danger-subtle" style="width: 80px; height: 80px; font-size: 2.25rem;">
                        <i class="bi bi-exclamation-triangle"></i>
                    </span>
                }
            </div>

            <h1 class="display-5 fw-bold text-dark mb-2">
                @(statusCode == 404 ? "404 · Halaman Tidak Ditemukan" : $"{statusCode} · Terjadi Kendala")
            </h1>

            <p class="lead text-muted mb-4 fs-6">
                @(Model.Message ?? "Maaf, permintaan Anda tidak dapat diproses saat ini.")
            </p>

            <div class="d-flex justify-content-center gap-3 mb-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-house-door me-1"></i> Kembali ke Beranda
                </a>
                <a asp-controller="Articles" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                    <i class="bi bi-newspaper me-1"></i> Jelajahi Berita
                </a>
            </div>

            @if (Model.ShowRequestId)
            {
                <div class="mt-4 pt-3 border-top">
                    <p class="small text-muted mb-0">
                        Kode Pelacakan (Trace ID): <code class="user-select-all">@Model.RequestId</code>
                    </p>
                </div>
            }
        </div>
    </div>
</div>
