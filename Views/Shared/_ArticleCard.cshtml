@model ArticleCardViewModel

<div class="card h-100 border shadow-subtle rounded-3 overflow-hidden article-card transition-all">
    <div class="position-relative overflow-hidden" style="aspect-ratio: 16/9; background-color: var(--color-surface-dark);">
        @if (!string.IsNullOrEmpty(Model.FeaturedImageUrl))
        {
            <a asp-controller="Articles" asp-action="Detail" asp-route-slug="@Model.Slug" class="d-block w-100 h-100">
                <img src="@Model.FeaturedImageUrl" alt="@Model.Title" class="w-100 h-100 object-fit-cover article-thumb transition-transform" loading="lazy" />
            </a>
        }
        else
        {
            <a asp-controller="Articles" asp-action="Detail" asp-route-slug="@Model.Slug" class="d-flex w-100 h-100 align-items-center justify-content-center text-decoration-none text-muted">
                <div class="text-center p-3">
                    <i class="bi bi-newspaper fs-1 text-secondary opacity-50"></i>
                    <div class="small fw-semibold mt-1">NewsPortal</div>
                </div>
            </a>
        }

        @if (!string.IsNullOrEmpty(Model.CategoryName))
        {
            <a asp-controller="Categories" asp-action="Detail" asp-route-slug="@Model.CategorySlug" class="position-absolute top-0 start-0 m-3 badge bg-primary text-white text-decoration-none rounded-pill px-3 py-1 fw-semibold shadow-sm" style="font-size: 0.75rem;">
                @Model.CategoryName
            </a>
        }
    </div>

    <div class="card-body d-flex flex-column p-3 p-md-4">
        <h5 class="card-title fw-bold mb-2 line-clamp-2 fs-5">
            <a asp-controller="Articles" asp-action="Detail" asp-route-slug="@Model.Slug" class="text-dark text-decoration-none text-hover-primary">
                @Model.Title
            </a>
        </h5>

        <p class="card-text text-muted small mb-3 line-clamp-3 flex-grow-1">
            @Model.Excerpt
        </p>

        <div class="d-flex align-items-center justify-content-between pt-3 border-top text-muted small mt-auto" style="font-size: 0.8rem;">
            <div class="d-flex align-items-center gap-2 text-truncate me-2">
                <span class="avatar-circle-sm" style="width: 24px; height: 24px; font-size: 0.7rem;">
                    @(string.IsNullOrEmpty(Model.AuthorName) ? "P" : Model.AuthorName.Substring(0, 1).ToUpper())
                </span>
                <span class="text-truncate fw-medium">@Model.AuthorName</span>
            </div>
            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                <span><i class="bi bi-clock me-1"></i>@Model.ReadingTimeMinutes mnt</span>
                <span>&bull;</span>
                <span title="Suka"><i class="bi bi-heart text-danger me-1"></i>@Model.LikesCount</span>
            </div>
        </div>
    </div>
</div>
