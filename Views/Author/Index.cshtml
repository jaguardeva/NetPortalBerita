@model ArticleListViewModel
@{
    ViewData["Title"] = "Kelola Artikel";
}

<div class="py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1 fw-bold">Area Penulis</h1>
            <p class="text-muted mb-0 small">Kelola tulisan, draf, dan publikasi artikel Anda.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i>
                <span>Tulis Artikel Baru</span>
            </a>
        </div>
    </div>

    <!-- Filters & Search -->
    <div class="card border-0 shadow-subtle mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Cari judul artikel..." value="@Model.SearchQuery" />
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="">Semua Status</option>
                        <option value="Published" selected="@(Model.StatusFilter == ArticleStatus.Published)">Dipublikasikan</option>
                        <option value="Draft" selected="@(Model.StatusFilter == ArticleStatus.Draft)">Draf</option>
                        <option value="Archived" selected="@(Model.StatusFilter == ArticleStatus.Archived)">Diarsipkan</option>
                    </select>
                </div>
                <div class="col-6 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-primary w-100">
                        Filter
                    </button>
                    @if (!string.IsNullOrEmpty(Model.SearchQuery) || Model.StatusFilter.HasValue)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Reset filter">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Articles Table / Empty State -->
    @if (!Model.Articles.Any())
    {
        <div class="card border shadow-subtle text-center py-5">
            <div class="card-body">
                <div class="avatar-circle mx-auto mb-3 bg-light text-muted border-0" style="width: 64px; height: 64px;">
                    <i class="bi bi-journal-text fs-2"></i>
                </div>
                <h5 class="fw-bold">Belum Ada Artikel</h5>
                <p class="text-muted small mb-3">
                    @(string.IsNullOrEmpty(Model.SearchQuery) && !Model.StatusFilter.HasValue
                        ? "Anda belum menulis artikel apa pun. Mulai tulis artikel pertama Anda sekarang!"
                        : "Tidak ditemukan artikel yang sesuai dengan filter pencarian Anda.")
                </p>
                <a asp-action="Create" class="btn btn-primary btn-sm px-3">
                    <i class="bi bi-pen me-1"></i> Buat Artikel
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border shadow-subtle overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th scope="col" style="min-width: 250px;">Artikel</th>
                            <th scope="col">Kategori</th>
                            <th scope="col">Status</th>
                            <th scope="col">Tanggal</th>
                            <th scope="col" class="text-center">Aktivitas</th>
                            <th scope="col" class="text-end" style="min-width: 140px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var article in Model.Articles)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(article.FeaturedImageUrl))
                                        {
                                            <img src="@article.FeaturedImageUrl" alt="@article.Title" class="rounded object-fit-cover flex-shrink-0" style="width: 54px; height: 42px;" />
                                        }
                                        else
                                        {
                                            <div class="rounded bg-light border d-flex align-items-center justify-content-center text-muted flex-shrink-0" style="width: 54px; height: 42px;">
                                                <i class="bi bi-image small"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-bold text-dark text-truncate" style="max-width: 320px;" title="@article.Title">
                                                @article.Title
                                            </div>
                                            <small class="text-muted">Slug: @article.Slug</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@article.CategoryName</span>
                                </td>
                                <td>
                                    @if (article.Status == ArticleStatus.Published)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Terbit
                                        </span>
                                    }
                                    else if (article.Status == ArticleStatus.Draft)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2 py-1">
                                            <i class="bi bi-clock me-1"></i>Draf
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2 py-1">
                                            Diarsipkan
                                        </span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    <div>@article.CreatedAt.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("id-ID"))</div>
                                    @if (article.PublishedAt.HasValue)
                                    {
                                        <div class="text-success" style="font-size: 0.75rem;">Terbit: @article.PublishedAt.Value.ToString("dd/MM/yy")</div>
                                    }
                                </td>
                                <td class="text-center small text-muted">
                                    <span class="me-2" title="Suka"><i class="bi bi-heart text-danger"></i> @article.LikesCount</span>
                                    <span title="Komentar"><i class="bi bi-chat text-primary"></i> @article.CommentsCount</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <!-- Edit button -->
                                        <a asp-action="Edit" asp-route-id="@article.Id" class="btn btn-outline-secondary" title="Edit Artikel">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <!-- Quick Status Toggle -->
                                        <form asp-action="ToggleStatus" asp-route-id="@article.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-secondary" title="@(article.Status == ArticleStatus.Published ? "Jadikan Draf" : "Publikasikan Sekarang")">
                                                <i class="bi @(article.Status == ArticleStatus.Published ? "bi-eye-slash" : "bi-upload text-success")"></i>
                                            </button>
                                        </form>

                                        <!-- Delete Modal Trigger -->
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@article.Id" title="Hapus Artikel">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Confirmation Modal -->
                                    <div class="modal fade" id="deleteModal-@article.Id" tabindex="-1" aria-labelledby="deleteModalLabel-@article.Id" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered text-start">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title fs-6 fw-bold" id="deleteModalLabel-@article.Id">Konfirmasi Penghapusan</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="mb-2">Apakah Anda yakin ingin menghapus artikel ini?</p>
                                                    <div class="p-2 bg-light rounded small fw-semibold text-dark">
                                                        @article.Title
                                                    </div>
                                                    <small class="text-danger mt-2 d-block">Tindakan ini tidak dapat dibatalkan.</small>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                                                    <form asp-action="Delete" asp-route-id="@article.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm">
                                                            <i class="bi bi-trash me-1"></i> Ya, Hapus
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white border-top py-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                    <small class="text-muted">
                        Menampilkan halaman @Model.CurrentPage dari @Model.TotalPages (Total @Model.TotalCount artikel)
                    </small>
                    <nav aria-label="Navigasi halaman artikel">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-status="@Model.StatusFilter" asp-route-search="@Model.SearchQuery">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-status="@Model.StatusFilter" asp-route-search="@Model.SearchQuery">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-status="@Model.StatusFilter" asp-route-search="@Model.SearchQuery">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    }
</div>
