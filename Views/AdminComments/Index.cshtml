@model AdminCommentListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Moderasi Komentar";
}

<div class="mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Moderasi Komentar</h1>
            <p class="text-muted small mb-0">Pantau dan kelola komentar pembaca untuk menjaga etika dan ketertiban diskusi.</p>
        </div>
    </div>
</div>

<!-- Filters Bar -->
<div class="card border shadow-subtle mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Cari isi komentar, artikel, atau pengguna..." value="@Model.SearchQuery" />
                </div>
            </div>
            <div class="col-6 col-md-4">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">Semua Status</option>
                    <option value="Published" selected="@(Model.StatusFilter == CommentStatus.Published)">Terbit (Ditampilkan)</option>
                    <option value="Hidden" selected="@(Model.StatusFilter == CommentStatus.Hidden)">Disembunyikan</option>
                </select>
            </div>
            <div class="col-6 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100">
                    Filter
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery) || Model.StatusFilter.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset filter">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Comments Table -->
<div class="card border shadow-subtle overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-secondary text-uppercase">
                <tr>
                    <th style="min-width: 280px;">Isi Komentar</th>
                    <th>Pengirim</th>
                    <th>Artikel Terkait</th>
                    <th>Status</th>
                    <th>Tanggal</th>
                    <th class="text-end" style="min-width: 130px;">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Comments.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            Tidak ditemukan komentar yang sesuai.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var c in Model.Comments)
                    {
                        <tr>
                            <td>
                                <p class="mb-1 text-dark small" style="white-space: pre-line;">@c.Content</p>
                            </td>
                            <td>
                                <div class="fw-bold small text-dark">@c.UserName</div>
                                <div class="text-muted" style="font-size: 0.72rem;">@c.UserEmail</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(c.ArticleSlug))
                                {
                                    <a asp-controller="Articles" asp-action="Detail" asp-route-slug="@c.ArticleSlug" target="_blank" class="small text-truncate text-decoration-none d-block" style="max-width: 200px;" title="@c.ArticleTitle">
                                        <i class="bi bi-box-arrow-up-right me-1"></i>@c.ArticleTitle
                                    </a>
                                }
                                else
                                {
                                    <span class="small text-muted">@c.ArticleTitle</span>
                                }
                            </td>
                            <td>
                                @if (c.Status == CommentStatus.Published)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1" style="font-size: 0.72rem;">
                                        <i class="bi bi-check-circle me-1"></i>Terbit
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1" style="font-size: 0.72rem;">
                                        <i class="bi bi-eye-slash me-1"></i>Disembunyikan
                                    </span>
                                }
                            </td>
                            <td class="small text-muted" style="font-size: 0.75rem;">
                                @c.CreatedAt.ToString("dd MMM yyyy, HH:mm", new System.Globalization.CultureInfo("id-ID"))
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (c.Status == CommentStatus.Published)
                                    {
                                        <form asp-action="Hide" asp-route-id="@c.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning" title="Sembunyikan Komentar dari Publik">
                                                <i class="bi bi-eye-slash"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Restore" asp-route-id="@c.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Pulihkan Komentar ke Publik">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </form>
                                    }

                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteCommentModal-@c.Id" title="Hapus Permanen">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>

                                <!-- Delete Modal -->
                                <div class="modal fade" id="deleteCommentModal-@c.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered text-start">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fs-6 fw-bold">Hapus Komentar Permanen</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-2">Yakin ingin menghapus permanen komentar dari <strong>@c.UserName</strong>?</p>
                                                <div class="p-2 bg-light rounded small text-secondary">
                                                    "@c.Content"
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger btn-sm">Ya, Hapus</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
