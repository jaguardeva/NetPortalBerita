@model LoginViewModel
@{
    ViewData["Title"] = "Masuk";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <div class="mb-3">
                <span class="avatar-circle mx-auto" style="width: 56px; height: 56px; font-size: 1.35rem;">
                    <i class="bi bi-person-fill"></i>
                </span>
            </div>
            <h1 class="auth-title">Selamat Datang Kembali</h1>
            <p class="auth-subtitle">Masuk untuk membaca, berkomentar, dan menyukai artikel.</p>
        </div>

        <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3 border-0 bg-danger-subtle text-danger" role="alert"></div>

            @if (ViewBag.InactiveAlert != null)
            {
                <div class="alert alert-danger py-2 small mb-3 border-0 bg-danger-subtle text-danger" role="alert">
                    <i class="bi bi-exclamation-octagon-fill me-1"></i> @ViewBag.InactiveAlert
                </div>
            }

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-envelope"></i>
                    </span>
                    <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="nama@email.com" autocomplete="email" autofocus />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <label asp-for="Password" class="form-label mb-0"></label>
                </div>
                <div class="input-group mt-1">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-lock"></i>
                    </span>
                    <input asp-for="Password" class="form-control border-start-0 ps-0" placeholder="••••••••" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMeCheck" />
                <label class="form-check-label small text-secondary" for="rememberMeCheck">
                    @Html.DisplayNameFor(m => m.RememberMe)
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                <i class="bi bi-box-arrow-in-right me-1"></i> Masuk Sekarang
            </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top">
            <p class="small text-muted mb-0">
                Belum memiliki akun?
                <a asp-controller="Account" asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]" class="fw-semibold">Daftar sekarang</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
