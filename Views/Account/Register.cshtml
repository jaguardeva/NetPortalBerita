@model RegisterViewModel
@{
    ViewData["Title"] = "Daftar Akun";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <div class="mb-3">
                <span class="avatar-circle mx-auto" style="width: 56px; height: 56px; font-size: 1.35rem;">
                    <i class="bi bi-person-plus-fill"></i>
                </span>
            </div>
            <h1 class="auth-title">Buat Akun Baru</h1>
            <p class="auth-subtitle">Bergabunglah untuk membaca dan berdiskusi seputar berita terkini.</p>
        </div>

        <form asp-controller="Account" asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3 border-0 bg-danger-subtle text-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-person"></i>
                    </span>
                    <input asp-for="DisplayName" class="form-control border-start-0 ps-0" placeholder="Nama Anda" autocomplete="name" autofocus />
                </div>
                <span asp-validation-for="DisplayName" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-envelope"></i>
                    </span>
                    <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="nama@email.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-lock"></i>
                    </span>
                    <input asp-for="Password" class="form-control border-start-0 ps-0" placeholder="Minimal 8 karakter" autocomplete="new-password" />
                </div>
                <div class="form-text small text-muted">Min 8 karakter: huruf besar, huruf kecil, angka, dan simbol.</div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-shield-lock"></i>
                    </span>
                    <input asp-for="ConfirmPassword" class="form-control border-start-0 ps-0" placeholder="Ulangi kata sandi" autocomplete="new-password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                <i class="bi bi-person-check me-1"></i> Daftar Sekarang
            </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top">
            <p class="small text-muted mb-0">
                Sudah memiliki akun?
                <a asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" class="fw-semibold">Masuk di sini</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
