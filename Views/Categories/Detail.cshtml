@model CategoryDetailViewModel
@{
    ViewData["Title"] = $"Berita {Model.Name}";
}

<div class="py-4">
    <!-- Category Header Banner -->
    <div class="card border-0 shadow-subtle mb-4" style="background-color: var(--color-surface);">
        <div class="card-body p-4 p-md-5">
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Beranda</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Kategori</li>
                </ol>
            </nav>
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h1 class="h2 fw-bold mb-2">@Model.Name</h1>
                    <p class="text-muted small mb-0" style="max-width: 600px;">
                        @(string.IsNullOrEmpty(Model.Description) ? $"Kumpulan publikasi berita dan artikel terhangat seputar {Model.Name}." : Model.Description)
                    </p>
                </div>
                <div class="flex-shrink-0">
                    <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">
                        @Model.TotalCount Berita
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Articles Feed -->
    @if (!Model.Articles.Any())
    {
        <partial name="_EmptyState" model='($"Belum Ada Berita di {Model.Name}", $"Saat ini belum ada artikel yang dipublikasikan pada kategori {Model.Name}.", "Kembali ke Beranda", "/")' />
    }
    else
    {
        <div class="row g-4 mb-5">
            @foreach (var article in Model.Articles)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <partial name="_ArticleCard" model="article" />
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Navigasi kategori" class="d-flex justify-content-center">
                <ul class="pagination">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-controller="Categories" asp-action="Detail" asp-route-slug="@Model.Slug" asp-route-page="@(Model.CurrentPage - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-controller="Categories" asp-action="Detail" asp-route-slug="@Model.Slug" asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-controller="Categories" asp-action="Detail" asp-route-slug="@Model.Slug" asp-route-page="@(Model.CurrentPage + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
